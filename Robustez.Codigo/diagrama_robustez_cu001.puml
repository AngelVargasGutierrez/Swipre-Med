@startuml Robustez_CU001_Codigo_MOPGIMED

left to right direction

title "Diagrama de Robustez — CU001 (fiel al código)\nIniciar Sesión · RF-001 · MOPGIMED"

skinparam {
  backgroundColor    #FFFFFF
  shadowing          false
  defaultFontName    Segoe UI
  defaultFontSize    10
  ArrowColor         #B91C1C
  ArrowThickness     1.5
  ArrowFontSize      9
}

skinparam actor {
  BorderColor        #B91C1C
  BackgroundColor    #FFF1F2
  FontColor          #7F1D1D
  FontStyle          Bold
}

skinparam boundary {
  BorderColor        #1D4ED8
  BackgroundColor    #EFF6FF
  FontColor          #1E3A8A
}

skinparam control {
  BorderColor        #B45309
  BackgroundColor    #FFFBEB
  FontColor          #78350F
}

skinparam entity {
  BorderColor        #065F46
  BackgroundColor    #ECFDF5
  FontColor          #064E3B
}

skinparam package {
  BorderColor        #CBD5E1
  BackgroundColor    #F8FAFC
  FontStyle          Bold
}

' ═══════════════════════════════════════════
'  ACTOR
' ═══════════════════════════════════════════
actor "Personal\ndel Hospital" as ACTOR

' ═══════════════════════════════════════════
'  FRONTERA — B1 → B2 (archivos React)
' ═══════════════════════════════════════════
package "Frontera  —  Login.jsx · App.jsx" as PKG_B {
  boundary "B1 — Login.jsx\nformulario usuario+contraseña\napi.login(username, password)\nPOST /api/auth/login" as B1
  boundary "B2 — App.jsx\nsetUser(data)\ncontexto global de sesión\nredirige al Dashboard" as B2
  B1 -[hidden]down-> B2
}

' ═══════════════════════════════════════════
'  CONTROL — C1 → C2 (funciones reales)
' ═══════════════════════════════════════════
package "Control  —  Backend Express" as PKG_C {
  control "C1 — authController.js\nlogin(req, res)\nfindByCredentials(username, password)\nROLE_MENUS[user.role]" as C1
  control "C2 — reporteModel.js\nregistrarAccion(\n  user.name, 'Inició sesión',\n  'Acceso', user.role_label\n)" as C2
  C1 -[hidden]down-> C2
}

' ═══════════════════════════════════════════
'  ENTIDAD — E1 → E2 (persistencia real)
' ═══════════════════════════════════════════
package "Entidad  —  MySQL" as PKG_E {
  entity "E1 — userModel.js\nMySQL tabla users\nSELECT WHERE username=?\nAND password=? AND estado='Activo'" as E1
  entity "E2 — reporteModel.js\nMySQL historial_acciones\nINSERT fecha, usuario,\naccion, modulo, detalle" as E2
  E1 -[hidden]down-> E2
}

' ═══════════════════════════════════════════
'  POSICIONAMIENTO Actor | Frontera | Control | Entidad
' ═══════════════════════════════════════════
ACTOR -[hidden]right-> B1
B1    -[hidden]right-> C1
C1    -[hidden]right-> E1

B2 -[hidden]right-> C2
C2 -[hidden]right-> E2

' ═══════════════════════════════════════════
'  FLUJO
' ═══════════════════════════════════════════
ACTOR --> B1 : 1. Ingresa usuario\ny contraseña

B1 --> C1 : 2. api.login()\nPOST /api/auth/login

C1 --> E1 : 3. findByCredentials()\nSELECT FROM users

E1 --> C1 : 4a. null → 401\nCredenciales incorrectas
C1 --> B1 : muestra error

E1 --> C1 : 4b. usuario encontrado\ny Activo

C1 --> C2 : 5. registrarAccion()\n'Inició sesión'
C2 --> E2 : 6. INSERT\nhistorial_acciones

C1 --> B2 : 7. res.json({\n  id, username, role,\n  name, roleLabel, menu\n})
B2 --> ACTOR : 8. setUser(data)\nredirige al Dashboard

@enduml
