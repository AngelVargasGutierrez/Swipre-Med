@startuml Robustez_CU003_Codigo_MOPGIMED

left to right direction

title "Diagrama de Robustez — CU003 (fiel al código)\nVisualizar Historial de Acciones · RF-003 · MOPGIMED"

skinparam {
  backgroundColor    #FFFFFF
  shadowing          false
  defaultFontName    Segoe UI
  defaultFontSize    10
  ArrowColor         #B91C1C
  ArrowThickness     1.5
  ArrowFontSize      9
}

skinparam actor {
  BorderColor        #B91C1C
  BackgroundColor    #FFF1F2
  FontColor          #7F1D1D
  FontStyle          Bold
}

skinparam boundary {
  BorderColor        #1D4ED8
  BackgroundColor    #EFF6FF
  FontColor          #1E3A8A
}

skinparam control {
  BorderColor        #B45309
  BackgroundColor    #FFFBEB
  FontColor          #78350F
}

skinparam entity {
  BorderColor        #065F46
  BackgroundColor    #ECFDF5
  FontColor          #064E3B
}

skinparam package {
  BorderColor        #CBD5E1
  BackgroundColor    #F8FAFC
  FontStyle          Bold
}

' ═══════════════════════════════════════════
'  ACTOR
' ═══════════════════════════════════════════
actor "Administrador\ndel Sistema" as ACTOR

' ═══════════════════════════════════════════
'  FRONTERA — Usuarios.jsx (sección historial)
' ═══════════════════════════════════════════
package "Frontera  —  Usuarios.jsx" as PKG_B {
  boundary "B1 — sección superior\nuseEffect → cargar()\napi.getUsers()\nsetHistorial(data.historial)" as B1
  boundary "B2 — tabla historial\nhistorial.map((h,i) => <tr>)\nColumnas: Fecha · Usuario\nAcción · Módulo · Detalles" as B2
  B1 -[hidden]down-> B2
}

' ═══════════════════════════════════════════
'  CONTROL — Backend Express
' ═══════════════════════════════════════════
package "Control  —  Backend Express" as PKG_C {
  control "C1 — userController.js\ngetAll(req, res)\nPromise.all([\n  userModel.findAll(),\n  reporteModel.getHistorial()\n])" as C1
  control "C2 — reporteModel.js\nregistrarAccion(usuario, accion,\n  modulo, detalle)\ncalled from authController.js\nand userController.js" as C2
  C1 -[hidden]down-> C2
}

' ═══════════════════════════════════════════
'  ENTIDAD — MySQL
' ═══════════════════════════════════════════
package "Entidad  —  MySQL" as PKG_E {
  entity "E1 — userModel.js\nMySQL tabla users\nSELECT id,username,role,\nname,role_label,email,\nestado,created_at FROM users" as E1
  entity "E2 — reporteModel.js\nMySQL historial_acciones\nSELECT fecha,usuario,accion,\nmodulo,detalle ORDER BY id DESC\nLIMIT 20" as E2
  E1 -[hidden]down-> E2
}

' ═══════════════════════════════════════════
'  POSICIONAMIENTO Actor | Frontera | Control | Entidad
' ═══════════════════════════════════════════
ACTOR -[hidden]right-> B1
B1    -[hidden]right-> C1
C1    -[hidden]right-> E1

B2 -[hidden]right-> C2
C2 -[hidden]right-> E2

' ═══════════════════════════════════════════
'  FLUJO
' ═══════════════════════════════════════════
ACTOR --> B1 : 1. navega a\nGestión de Usuarios
B1 --> C1 : 2. api.getUsers()\nGET /api/users\nuserController.getAll()

C1 --> E1 : 3. userModel.findAll()\nSELECT FROM users
E1 --> C1 : 4. usersRaw[]

C1 --> E2 : 5. reporteModel.getHistorial()\nSELECT FROM historial_acciones\nORDER BY id DESC LIMIT 20
E2 --> C1 : 6. historial[]

C1 --> B1 : 7. res.json({ users, historial })\nsetHistorial(data.historial)
B1 --> B2 : 8. renderiza tabla\ndel historial

B2 --> ACTOR : 9. tabla visible:\nhasta 20 acciones recientes

' Registro automático
C2 --> E2 : INSERT historial_acciones\n(desde authController.js\ny userController.js\nen cada operación)

@enduml
