@startuml Secuencia CU004 MOPGIMED

title "Diagrama de Secuencia — CU004: Registrar Lote de Medicamento Existente (RF-004)\nMOPGIMED · Sistema Inteligente de Inventario Farmacéutico"

autonumber

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequenceArrowColor #B91C1C
skinparam sequenceArrowThickness 1.5
skinparam sequenceLifeLineBorderColor #B91C1C
skinparam sequenceGroupBorderColor #B91C1C
skinparam sequenceGroupBackgroundColor #FFF5F5
skinparam sequenceGroupFontStyle Bold
skinparam noteFontSize 9
skinparam noteBackgroundColor #FFFBEB
skinparam noteBorderColor #B45309

skinparam actor {
  BackgroundColor #FFF1F2
  BorderColor #B91C1C
  FontColor #7F1D1D
  FontStyle Bold
}

skinparam participant {
  BackgroundColor #FFFFFF
  BorderColor #64748B
  FontColor #1E293B
  FontSize 10
}

skinparam box {
  FontStyle Bold
  FontSize 11
}

actor "Personal del Hospital" as ACTOR

box "Frontera — Pantallas que ve el personal" #EFF6FF
  participant "Pantalla de Registro\nde Lote (Nuevo Medicamento)" as B1
  participant "Lista Desplegable\nde Sugerencias (max. 6)" as B2
  participant "Formulario de Datos\ndel Lote Fisico" as B3
  participant "Confirmacion y Retorno\na Medicamentos" as B4
end box

box "Control — Procesos internos del sistema" #FFFBEB
  participant "Buscador por Laboratorio\ny Nombre" as C1
  participant "Registrador de Lote\ny Actualizacion de Stock" as C2
  participant "Calculador de Estado\nde Inventario" as C3
  participant "Registrador\nde Actividad" as C4
end box

box "Entidad — Informacion guardada" #ECFDF5
  participant "Inventario de\nMedicamentos" as E1
  participant "Catalogo de\nLaboratorios" as E2
  participant "Historial\nde Actividad" as E3
end box

ACTOR -> B1 : En Gestion de Medicamentos pulsa\n"Nuevo Medicamento" para registrar lote
B1 -> E2 : Carga lista de\nlaboratorios disponibles
E2 --> B1 : Devuelve fabricantes\ndisponibles en el sistema
B1 -> E1 : Carga el catalogo\ncompleto de medicamentos
E1 --> B1 : Devuelve inventario\ncargado en pantalla

ACTOR -> B1 : Paso 1: selecciona\nlaboratorio fabricante
ACTOR -> B1 : Paso 2: escribe nombre\nen el buscador

B1 -> C1 : Filtra por laboratorio y texto;\nmaximos 6 coincidencias
C1 -> E1 : Consulta coincidencias\nen el inventario actual
E1 --> C1 : Medicamentos que\ncoinciden con la busqueda
C1 -> B2 : Devuelve las sugerencias\nencontradas
B2 --> ACTOR : Muestra listado desplegable;\nel personal elige una opcion

B1 -> B1 : Autocompleta nombre, laboratorio\ny categoria como campos de solo lectura

ACTOR -> B3 : Completa lote, vencimiento, costo,\nprecio de venta, stock minimo,\nstock inicial y registro sanitario
ACTOR -> B3 : Pulsa "Registrar lote"

B3 -> C2 : Envia identificador del\nmedicamento y datos del lote

alt Sin medicamento seleccionado o datos invalidos
  C2 -> B3 : Rechaza el formulario
  B3 -> ACTOR : Muestra aviso de\ncorreccion requerida

else Datos validos
  C2 -> E1 : Suma el stock inicial al existente,\nactualiza lote, vencimiento,\nprecios y stock minimo
  C2 -> C3 : Solicita recalcular\nel estado del medicamento
  C3 -> E1 : Persiste el nuevo estado:\nNormal, Bajo o Critico
  C2 -> C4 : Notifica el registro\ndel nuevo lote
  C4 -> E3 : Guarda usuario, fecha\ny detalle del lote registrado
  C2 -> B4 : Lote registrado\ncorrectamente
  B4 --> ACTOR : Muestra confirmacion\ny vuelve al listado de medicamentos
end

@enduml
