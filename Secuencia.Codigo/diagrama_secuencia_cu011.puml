@startuml Secuencia_CU011_Codigo_MOPGIMED
title "Diagrama de Secuencia — CU011 (fiel al código)\nVisualizar Semáforo de Vencimientos · RF-011"

skinparam {
  backgroundColor    #FFFFFF
  shadowing          false
  defaultFontName    Segoe UI
  defaultFontSize    10
  defaultFontColor   #1E293B
  ArrowColor         #B91C1C
  ArrowThickness     1.5
  ArrowFontSize      9
  ArrowFontColor     #475569
}
skinparam actor {
  BorderColor        #B91C1C
  BackgroundColor    #FFF1F2
  FontColor          #7F1D1D
  FontStyle          Bold
  FontSize           11
}
skinparam participant {
  BorderColor        #1D4ED8
  BackgroundColor    #EFF6FF
  FontColor          #1E3A8A
  FontSize           10
}
skinparam database {
  BorderColor        #065F46
  BackgroundColor    #ECFDF5
  FontColor          #064E3B
  FontSize           10
}

actor "Usuario (Jefatura / Logística)" as User
participant "ControlInventario.jsx\n(Frontend)" as View
participant "api.js\n(Frontend)" as API
participant "inventarioController.js\n(Backend)" as Ctrl
participant "inventarioModel.js\n(Modelo BD)" as Model
database "MySQL" as DB

User -> View : 1. Accede a módulo de control
View -> API : 2. getInventario()
API -> Ctrl : 3. HTTP GET /api/inventario
Ctrl -> Model : 4. getTotales() (Cuenta MySQL)
Model -> DB : 5. SUM(CASE WHEN vencimiento <= CURDATE() + 30)
DB --> Model : 6. Devuelve totals.por_vencer
Model --> Ctrl : 7. Retorna { medicamentos, totals }
Ctrl -> API : 8. res.json(data)
API --> View : 9. data recibido
View -> View : 10. diasRestantes(m.vencimiento)\n-> evalúa (vencimiento - TODAY)
View -> View : 11. map() en la tabla de React:\n<0=Gris, <=30=Rojo, <=90=Amarillo
View --> User : 12. Renderiza badges en la columna "Días Restantes"
@enduml
