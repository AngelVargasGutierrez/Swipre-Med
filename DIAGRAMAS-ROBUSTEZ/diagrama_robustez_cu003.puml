 @startuml Robustez - CU003 Historial de Acciones MOPGIMED

top to bottom direction

title "Diagrama de Robustez — CU003: Visualizar Historial de Acciones (RF-003)\nMOPGIMED · Sistema Inteligente de Inventario Farmacéutico"

skinparam {
  backgroundColor    #FFFFFF
  shadowing          false
  defaultFontName    Segoe UI
  defaultFontSize    10
  defaultFontColor   #1E293B
  ArrowColor         #B91C1C
  ArrowThickness     1.5
  ArrowFontSize      9
  ArrowFontColor     #475569
}

skinparam actor {
  BorderColor        #B91C1C
  BackgroundColor    #FFF1F2
  FontColor          #7F1D1D
  FontStyle          Bold
  FontSize           11
}

skinparam boundary {
  BorderColor        #1D4ED8
  BackgroundColor    #EFF6FF
  FontColor          #1E3A8A
  FontSize           10
}

skinparam control {
  BorderColor        #B45309
  BackgroundColor    #FFFBEB
  FontColor          #78350F
  FontSize           10
}

skinparam entity {
  BorderColor        #065F46
  BackgroundColor    #ECFDF5
  FontColor          #064E3B
  FontSize           10
}

skinparam package {
  BorderColor        #CBD5E1
  BackgroundColor    #F8FAFC
  FontStyle          Bold
  FontSize           11
  FontColor          #334155
}

' ─────────────────────────────────────────
'  ACTOR
' ─────────────────────────────────────────
actor "Administrador\ndel Sistema" as ACTOR

' ─────────────────────────────────────────
'  FILA 1 — Entidades (arriba)
' ─────────────────────────────────────────
package "Entidad  —  Información guardada en el sistema" as PKG_E {
  entity "Registro de Usuarios\n──────────────────\nNombre · Usuario · Rol · Estado\n(cargado junto al historial)" as E1
  entity "Historial de Actividad\n──────────────────\nFecha · Hora · Usuario\nAcción · Módulo · Detalle" as E2
  E1 -[hidden]right-> E2
}

' ─────────────────────────────────────────
'  FILA 2 — Frontera (izquierda)
' ─────────────────────────────────────────
package "Frontera  —  Pantallas que ve el Administrador" as PKG_B {
  boundary "Pantalla Gestión\nde Usuarios\n──────────────\nSección superior: tabla de usuarios\nSección inferior: historial de acciones" as B1
  boundary "Tabla del\nHistorial de Acciones\n──────────────\nColumnas: fecha, usuario,\nacción, módulo y detalle" as B2
  B1 -[hidden]down-> B2
}

' ─────────────────────────────────────────
'  FILA 2 — Control (derecha)
' ─────────────────────────────────────────
package "Control  —  Procesos que ejecuta el sistema automáticamente" as PKG_C {
  control "Consultor de Historial\n────────────\nCarga en paralelo la lista\nde usuarios y los últimos\n20 registros del historial" as C1
  C1 -[hidden]down-> C1
}

' ─────────────────────────────────────────
'  Posicionamiento: E arriba, B y C al lado
' ─────────────────────────────────────────
PKG_E -[hidden]down-> PKG_B
PKG_B -[hidden]right-> PKG_C

' ─────────────────────────────────────────
'  FLUJO — Visualizar historial
' ─────────────────────────────────────────
ACTOR --> B1  : 1. Accede al módulo\nGestión de Usuarios

B1    --> C1  : 2. Solicita usuarios\ne historial en paralelo

C1    --> E1  : 3. Consulta todos\nlos usuarios del sistema

C1    --> E2  : 4. Consulta los últimos\n20 registros de actividad\nordenados de más reciente a más antiguo

E1    --> C1  : 5. Devuelve lista\nde usuarios
E2    --> C1  : 6. Devuelve lista\nde acciones registradas

C1    --> B1  : 7. Entrega usuarios\ne historial juntos
B1    --> B2  : 8. Renderiza la tabla\ndel historial en pantalla

B2    --> ACTOR : 9. El Admin ve cada fila:\nfecha, usuario, acción,\nmódulo y detalle del evento

@enduml
