@startuml Robustez - CU004 Registrar Lote MOPGIMED

top to bottom direction

title "Diagrama de Robustez — CU004: Registrar Lote de Medicamento Existente (RF-004)\nMOPGIMED · Sistema Inteligente de Inventario Farmacéutico"

skinparam {
  backgroundColor    #FFFFFF
  shadowing          false
  defaultFontName    Segoe UI
  defaultFontSize    10
  defaultFontColor   #1E293B
  ArrowColor         #B91C1C
  ArrowThickness     1.5
  ArrowFontSize      9
  ArrowFontColor     #475569
}

skinparam actor {
  BorderColor        #B91C1C
  BackgroundColor    #FFF1F2
  FontColor          #7F1D1D
  FontStyle          Bold
  FontSize           11
}

skinparam boundary {
  BorderColor        #1D4ED8
  BackgroundColor    #EFF6FF
  FontColor          #1E3A8A
  FontSize           10
}

skinparam control {
  BorderColor        #B45309
  BackgroundColor    #FFFBEB
  FontColor          #78350F
  FontSize           10
}

skinparam entity {
  BorderColor        #065F46
  BackgroundColor    #ECFDF5
  FontColor          #064E3B
  FontSize           10
}

skinparam package {
  BorderColor        #CBD5E1
  BackgroundColor    #F8FAFC
  FontStyle          Bold
  FontSize           11
  FontColor          #334155
}

' ─────────────────────────────────────────
'  ACTOR
' ─────────────────────────────────────────
actor "Personal\ndel Hospital" as ACTOR

' ─────────────────────────────────────────
'  FILA 1 — Entidades (arriba, ancho completo)
' ─────────────────────────────────────────
package "Entidad  —  Información guardada en el sistema" as PKG_E {
  entity "Inventario de Medicamentos\n──────────────────\nNombre · Laboratorio · Lote\nStock · Vencimiento · Estado · Costos" as E1
  entity "Catálogo de Laboratorios\n──────────────────\nLista de fabricantes disponibles\npara filtrar la búsqueda" as E2
  entity "Historial de Actividad\n──────────────────\nFecha · Hora · Usuario\nDetalle del lote registrado" as E3
  E1 -[hidden]right-> E2
  E2 -[hidden]right-> E3
}

' ─────────────────────────────────────────
'  FILA 2 — Frontera (izquierda)
' ─────────────────────────────────────────
package "Frontera  —  Pantallas que ve el personal" as PKG_B {
  boundary "Pantalla Registro\nde Lote\n──────────────\nSelector de laboratorio +\nbuscador de medicamento" as B1
  boundary "Lista Desplegable\nde Sugerencias\n──────────────\nHasta 6 coincidencias\ndel inventario actual" as B2
  boundary "Formulario de Datos\ndel Lote Físico\n──────────────\nLote · Vencimiento · Costos\nStock mínimo · Stock inicial · R.S." as B3
  boundary "Confirmación\nde Registro\n──────────────\nAviso de éxito y retorno\nal listado de medicamentos" as B4
  B1 -[hidden]down-> B2
  B2 -[hidden]down-> B3
  B3 -[hidden]down-> B4
}

' ─────────────────────────────────────────
'  FILA 2 — Control (derecha)
' ─────────────────────────────────────────
package "Control  —  Procesos que ejecuta el sistema automáticamente" as PKG_C {
  control "Buscador por\nLaboratorio y Nombre\n────────────\nFiltra el inventario cargado\npor laboratorio y texto;\ndevuelve máximo 6 coincidencias" as C1
  control "Registrador\nde Lote y Stock\n────────────\nSuma el stock inicial al existente,\nactualiza lote, vencimiento\ny precios del medicamento" as C2
  control "Calculador\nde Estado\n────────────\nDetermina si el nuevo stock\ncoloca al medicamento en\nNormal, Bajo o Crítico" as C3
  control "Registrador\nde Actividad\n────────────\nAnota quién registró el lote,\nfecha, hora y detalle\nen el historial del sistema" as C4
  C1 -[hidden]down-> C2
  C2 -[hidden]down-> C3
  C3 -[hidden]down-> C4
}

' ─────────────────────────────────────────
'  Posicionamiento: E arriba, B y C al lado
' ─────────────────────────────────────────
PKG_E -[hidden]down-> PKG_B
PKG_B -[hidden]right-> PKG_C

' ─────────────────────────────────────────
'  FLUJO — Registrar lote de medicamento existente
' ─────────────────────────────────────────
ACTOR --> B1  : 1. Abre pantalla\nNuevo Medicamento

B1    --> E2  : 2. Carga lista\nde laboratorios disponibles
B1    --> E1  : 3. Carga inventario\ncompleto en pantalla

ACTOR --> B1  : 4. Selecciona laboratorio\nfabricante
ACTOR --> B1  : 5. Escribe nombre\ndel medicamento

B1    --> C1  : 6. Filtra por laboratorio\ny texto ingresado
C1    --> E1  : 7. Busca coincidencias\nen el inventario actual
C1    --> B2  : 8. Devuelve hasta\n6 sugerencias
B2    --> ACTOR : 9. El personal elige\nuna opción del listado

B1    --> B3  : 10. Autocompleta nombre,\nlaboratorio y categoría\n(solo lectura)
ACTOR --> B3  : 11. Completa los datos\ndel lote físico
ACTOR --> B3  : 12. Pulsa "Registrar lote"

B3    --> C2  : 13. Envía id del medicamento\ny datos del lote

C2    --> B4  : 14a. Datos inválidos:\nmuestra aviso de corrección
B4    --> ACTOR : el personal corrige

C2    --> E1  : 14b. Actualiza stock,\nlote, vencimiento y precios
C2    --> C3  : 15. Recalcula el estado\nNormal / Bajo / Crítico
C3    --> E1  : 16. Persiste el nuevo\nestado en el inventario
C2    --> C4  : 17. Notifica el registro\ndel lote
C4    --> E3  : 18. Guarda en el historial:\nusuario, fecha y detalle

C2    --> B4  : 19. Lote registrado\ncorrectamente
B4    --> ACTOR : 20. Confirmación de éxito\ny retorno al listado

@enduml
