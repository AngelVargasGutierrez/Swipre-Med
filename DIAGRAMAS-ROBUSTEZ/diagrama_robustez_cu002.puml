@startuml Robustez - CU002 Gestionar Usuarios MOPGIMED

top to bottom direction

title "Diagrama de Robustez — CU002: Gestionar Usuarios y Asignar Rol (RF-002)\nMOPGIMED · Sistema Inteligente de Inventario Farmacéutico"

skinparam {
  backgroundColor    #FFFFFF
  shadowing          false
  defaultFontName    Segoe UI
  defaultFontSize    10
  defaultFontColor   #1E293B
  ArrowColor         #B91C1C
  ArrowThickness     1.5
  ArrowFontSize      9
  ArrowFontColor     #475569
}

skinparam actor {
  BorderColor        #B91C1C
  BackgroundColor    #FFF1F2
  FontColor          #7F1D1D
  FontStyle          Bold
  FontSize           11
}

skinparam boundary {
  BorderColor        #1D4ED8
  BackgroundColor    #EFF6FF
  FontColor          #1E3A8A
  FontSize           10
}

skinparam control {
  BorderColor        #B45309
  BackgroundColor    #FFFBEB
  FontColor          #78350F
  FontSize           10
}

skinparam entity {
  BorderColor        #065F46
  BackgroundColor    #ECFDF5
  FontColor          #064E3B
  FontSize           10
}

skinparam package {
  BorderColor        #CBD5E1
  BackgroundColor    #F8FAFC
  FontStyle          Bold
  FontSize           11
  FontColor          #334155
}

' ─────────────────────────────────────────
'  ACTOR
' ─────────────────────────────────────────
actor "Administrador\ndel Sistema" as ACTOR

' ─────────────────────────────────────────
'  FILA 1 — Entidades (arriba, ancho completo)
' ─────────────────────────────────────────
package "Entidad  —  Información guardada en el sistema" as PKG_E {
  entity "Registro de Usuarios\n──────────────────\nNombre · Usuario · Contraseña\nEmail · Rol · Estado · Fecha creación" as E1
  entity "Tabla de Roles\n──────────────────\nAdministrador · Farmacia · Jefatura\n(etiqueta y permisos de cada rol)" as E2
  entity "Historial de Actividad\n──────────────────\nFecha · Hora · Administrador\nAcción realizada · Usuario afectado" as E3
  E1 -[hidden]right-> E2
  E2 -[hidden]right-> E3
}

' ─────────────────────────────────────────
'  FILA 2 — Frontera (izquierda)
' ─────────────────────────────────────────
package "Frontera  —  Pantallas que ve el Administrador" as PKG_B {
  boundary "Pantalla Gestión\nde Usuarios\n──────────────\nTabla con todos los usuarios:\nnombre, rol, estado y acciones" as B1
  boundary "Formulario\nNuevo / Editar Usuario\n──────────────\nCampos: nombre, usuario,\ncontraseña, rol y email" as B2
  boundary "Aviso de Error\n──────────────\nDatos incompletos,\nusuario duplicado o\ncontraseña vacía al crear" as B3
  B1 -[hidden]down-> B2
  B2 -[hidden]down-> B3
}

' ─────────────────────────────────────────
'  FILA 2 — Control (derecha)
' ─────────────────────────────────────────
package "Control  —  Procesos que ejecuta el sistema automáticamente" as PKG_C {
  control "Gestor de Usuarios\n────────────\nCarga la lista de usuarios,\ncrea, actualiza y cambia\nel estado de las cuentas" as C1
  control "Validador de Datos\n────────────\nVerifica campos obligatorios,\ndetecta usuario duplicado y\nexige contraseña al crear" as C2
  control "Asignador de Rol\n────────────\nDetermina la etiqueta\ny permisos del rol\nseleccionado por el Admin" as C3
  control "Registrador\nde Actividad\n────────────\nGuarda cada acción:\nquién, qué operación,\nfecha y hora exacta" as C4
  C1 -[hidden]down-> C2
  C2 -[hidden]down-> C3
  C3 -[hidden]down-> C4
}

' ─────────────────────────────────────────
'  Posicionamiento: E arriba, B y C al lado
' ─────────────────────────────────────────
PKG_E -[hidden]down-> PKG_B
PKG_B -[hidden]right-> PKG_C

' ─────────────────────────────────────────
'  FLUJO — Gestionar usuarios
' ─────────────────────────────────────────
ACTOR --> B1  : 1. Accede al módulo\nGestión de Usuarios

B1    --> C1  : 2. Solicita la lista\nde usuarios registrados
C1    --> E1  : 3. Consulta todos\nlos usuarios del sistema
E1    --> B1  : 4. Muestra la tabla\ncon nombre, rol y estado

ACTOR --> B1  : 5. Hace clic en\n"Nuevo Usuario" o en\nel ícono Editar
B1    --> B2  : 6. Abre el formulario\nvacío o pre-cargado

ACTOR --> B2  : 7. Completa o modifica\nlos campos y selecciona\nel rol del usuario
B2    --> C2  : 8. Envía datos\npara validación

C2    --> B3  : 9a. Datos inválidos\no usuario duplicado
B3    --> ACTOR : muestra el aviso\nde error al Admin

C2    --> C3  : 9b. Datos correctos:\nasigna o actualiza el rol
C3    --> E2  : 10. Consulta la etiqueta\ndel rol seleccionado
C3    --> C1  : 11. Rol asignado,\nprocede a guardar

C1    --> E1  : 12. Inserta o actualiza\nel registro del usuario
C1    --> C4  : 13. Notifica la\nacción realizada
C4    --> E3  : 14. Guarda en el historial:\nAdmin, acción, usuario\nafectado y fecha

C1    --> B1  : 15. Actualiza la tabla\ncon los cambios aplicados
B1    --> ACTOR : 16. El Admin verifica\nel resultado en la lista

@enduml
